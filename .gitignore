# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Rust / Tauri build artifacts
src-tauri/target/
src-tauri/gen/

# Lockfiles are intentionally NOT ignored — this is an application, not a
# library, so Cargo.lock and package-lock.json belong in the repo.

# Logs
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Updater signing keys. The real one lives outside the repo (~/.tauri), and
# losing it means never being able to update an installed copy again — but a
# copy landing in here by accident would be worse. The .pub half is public and
# lives in tauri.conf.json, not as a file.
*.key
*.pem

# Local environment
.env
.env.local
.env.*.local
