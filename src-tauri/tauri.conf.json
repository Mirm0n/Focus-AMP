{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Focus AMP",
  "version": "0.9.0",
  "identifier": "com.focusamp.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "zoomHotkeysEnabled": true,
        "title": "Focus AMP",
        "width": 1120,
        "height": 740,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob: https://*.mzstatic.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' blob: http://127.0.0.1:* http://localhost:*; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* https://*.radio-browser.info https://itunes.apple.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": {
        "depends": [
          "gstreamer1.0-libav",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFNjdCRkI3RDlEMUE5QkQKUldTOXFkSFp0NzluWHJNZStjalh1NUZYd1VOTWhqTEt2WENFMEFYQ3MwSjZneU5ibW93YUdjTlYK",
      "endpoints": [
        "https://github.com/Mirm0n/Focus-AMP/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
